        <mxCell id="subtitle" value="基准日：2026年09月16日 | 交易结构：协议收购 (Share Purchase Agreement) | 适用法：PRC Law" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#718096;" vertex="1" parent="1">
