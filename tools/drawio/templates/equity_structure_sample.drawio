        <mxCell id="subtitle" value="基准日：2026年09月11日 | 适用法：PRC Law | 核心主张：确认实际控制人地位与穿透持股比例" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#718096;" vertex="1" parent="1">
