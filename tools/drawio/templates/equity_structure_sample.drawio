        <mxCell id="subtitle" value="基准日：2026年9月 | 绘制目的：上市前股权架构重组及穿透核查 | 密级：保密商业信息" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#718096;" vertex="1" parent="1">
