<mxfile host="LexPrism" modified="2026-09-08T15:00:00.000Z" agent="LexPrism-Agent" version="24.0.0" type="device">
  <diagram id="litigation-timeline-01" name="事实时间线与证据链推导图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 标题区 -->
        <mxCell id="title" value="【LexPrism 争议解决参考】(2026) 沪01民初字第888号 买卖合同违约金案：事实时间线与证据链图谱" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;fontColor=#1A365D;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="950" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="原告：上海某智能供应链有限公司 (委托人) | 被告：某装备制造科技 (江苏) 有限公司 | 争点：逾期交货违约责任及免责事由是否成立" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#718096;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="850" height="20" as="geometry" />
        </mxCell>

        <!-- 诉讼核心请求与争议焦点 (顶部摘要) -->
        <mxCell id="claim_box" value="&lt;b&gt;【诉讼请求与法律构成要件】&lt;/b&gt;&lt;br&gt;依据《民法典》第577条、第585条，诉请判令被告：① 支付逾期交付违约金 380 万元；② 赔偿原告因停工停产产生的实际经济损失 120 万元。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2B6CB0;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="95" width="1070" height="50" as="geometry" />
        </mxCell>

        <!-- 时间轴主体容器 -->
        <!-- 节点 1：合同订立 -->
        <mxCell id="t1_date" value="&lt;b&gt;2025-03-15&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0B1E38;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t1_event" value="&lt;b&gt;签署《设备买卖及安装合同》&lt;/b&gt;&lt;br&gt;约定：标的额 4,200 万元；交货期为合同生效后 90 个自然日 (即 2025-06-13 前)。逾期违约金按日万分之五计收。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#2D3748;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="t1_evidence" value="&lt;b&gt;【证明支持：证据一】&lt;/b&gt;&lt;br&gt;原件《采购合同》及补充协议、双方签字盖章原件、网签电子签署存证报告。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- 节点 2：原告履约支付预付款 -->
        <mxCell id="t2_date" value="&lt;b&gt;2025-03-20&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0B1E38;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="170" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2_event" value="&lt;b&gt;原告按约足额支付 30% 首付款&lt;/b&gt;&lt;br&gt;原告依约向被告指定账户电汇人民币 1,260 万元。原告先合同义务已全部完成。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#2D3748;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="t2_evidence" value="&lt;b&gt;【证明支持：证据二】&lt;/b&gt;&lt;br&gt;招商银行电子回单、银行加盖业务章对账单、被告出具的《款项收讫确认函》。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="305" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- 节点 3：被告违约（违约起始日） -->
        <mxCell id="t3_date" value="&lt;b&gt;2025-06-14 (违约日)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E53E3E;strokeColor=#9B2C2C;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t3_event" value="&lt;b&gt;合同约定期限届满，被告未交付&lt;/b&gt;&lt;br&gt;原告现场工程师核实，被告工厂核心零部件尚未采购到位。构成实质性迟延履行违约。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FEB2B2;fontColor=#9B2C2C;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="210" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="t3_evidence" value="&lt;b&gt;【证明支持：证据三、四】&lt;/b&gt;&lt;br&gt;经公证的微信沟通记录（被告项目经理承认未交货）、现场联合巡查备忘录。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="305" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- 节点 4：原告催告与发函 -->
        <mxCell id="t4_date" value="&lt;b&gt;2025-07-01&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0B1E38;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="890" y="170" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t4_event" value="&lt;b&gt;发送《律师催告函》与履约督促&lt;/b&gt;&lt;br&gt;限期被告于 10 日内完成整机调试及发货，并明确提示违约金正持续计收。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#CBD5E0;fontColor=#2D3748;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="890" y="210" width="230" height="85" as="geometry" />
        </mxCell>
        <mxCell id="t4_evidence" value="&lt;b&gt;【证明支持：证据五】&lt;/b&gt;&lt;br&gt;EMS邮寄凭证、物流妥投签收单及电子回执，证明催告意思表示已有效送达。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#38A169;fontColor=#22543D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="890" y="305" width="230" height="60" as="geometry" />
        </mxCell>

        <!-- 连接横向时间轴 -->
        <mxCell id="e_t1_t2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B365D;strokeWidth=2;" edge="1" parent="1" source="t1_date" target="t2_date" />
        <mxCell id="e_t2_t3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E53E3E;strokeWidth=2.5;" edge="1" parent="1" source="t2_date" target="t3_date" />
        <mxCell id="e_t3_t4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1B365D;strokeWidth=2;" edge="1" parent="1" source="t3_date" target="t4_date" />

        <!-- 下半部分：双方争点与法庭证明力对抗矩阵 -->
        <mxCell id="issue_title" value="【法庭证据对抗与反驳意见研判】" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#1A365D;" vertex="1" parent="1">
          <mxGeometry x="50" y="395" width="400" height="25" as="geometry" />
        </mxCell>

        <!-- 争点一 -->
        <mxCell id="issue1_claim" value="&lt;b&gt;争点 1：逾期交货期间及违约金标准是否过高？&lt;/b&gt;&lt;br&gt;◆ &lt;b&gt;被告抗辩：&lt;/b&gt;日万分之五年化超18%，请求法院依《民法典》第585条过分高于实际损失予以大幅调减。&lt;br&gt;◆ &lt;b&gt;原告反驳策略：&lt;/b&gt;举证同行业类似高端智能设备租赁成本及替代采购差价（证据七），证明实际损失与违约金相当；违约金系双方商业谈判约定，不应轻易干预。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FEB2B2;fontColor=#7B1113;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="430" width="510" height="90" as="geometry" />
        </mxCell>

        <!-- 争点二 -->
        <mxCell id="issue2_claim" value="&lt;b&gt;争点 2：被告主张供应链上游停产构成不可抗力能否成立？&lt;/b&gt;&lt;br&gt;◆ &lt;b&gt;被告抗辩：&lt;/b&gt;第三方供应商原材料短缺属于不可预见事件，主张免除全部逾期违约责任。&lt;br&gt;◆ &lt;b&gt;原告反驳策略：&lt;/b&gt;依据《民法典》第593条（第三人原因违约），上游供应链波动属于正常的商业履约风险，不满足不可预见、不可避免、不能克服的三要件。抗辩依法不能成立。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontColor=#744210;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="430" width="530" height="90" as="geometry" />
        </mxCell>

        <!-- 证据漏洞与核验提示 -->
        <mxCell id="audit_box" value="&lt;b&gt;【LexPrism 独立三审计员·核验提示】&lt;/b&gt;&lt;br&gt;[一致性审计 PASS] 时间线节点与民事起诉状、证据目录保持 100% 对应，无日期矛盾。&lt;br&gt;[反面覆盖审计 PASS] 已针对被告潜在的“不可抗力免责”抗辩与“违约金调减请求”准备对抗证据与判例指引。&lt;br&gt;[待办缺口 GAP-01] 替代采购损失的增值税发票原件尚待委托人财务部调取，建议在第一次举证期限届满前补充提交。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#4A5568;fontColor=#1A202C;align=left;spacingLeft=10;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="540" width="1070" height="75" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
