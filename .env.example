# Copy this file to .env locally, then fill in the values. Do not commit .env.
# Obtain the key from Alibaba Cloud Model Studio (Bailian/DashScope).
DASHSCOPE_API_KEY=

# Replace {WorkspaceId} with your Bailian workspace ID. The default is the
# Beijing OpenAI-compatible endpoint documented by Model Studio.
DASHSCOPE_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Keep the explicit model ID for this direct-API smoke test.
QWEN_MODEL=qwen3.8-max
