  <diagram id="page-1" name="02-正式发布与异常恢复">
    <mxGraphModel dx="1800" dy="1730" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1730">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="LexPrism｜正式发布与异常恢复" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=40;fontColor=#163854;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="72" y="42" width="1656" height="60" />
        </mxCell>
        <mxCell id="sub" value="送审前固定 Word；发布时复制同一文件。审阅通过、律师确认、发布成功是三件不同的事。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#243B53;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="72" y="108" width="1656" height="72" />
        </mxCell>
        <mxCell id="footer" value="方案评审 v0.1 · 2026-09-17 · 人工触发对话，后台文件自动管理 · 尚未部署" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#243B53;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="72" y="1678" width="1656" height="35" />
        </mxCell>
        <mxCell id="label-0" value="命名：显示名与安全名分开；同名跨事项不合并；保留设备名、非法字符、链接越界及冲突均需处理。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#243B53;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1510" width="1690" height="75" />
        </mxCell>
        <mxCell id="label-1" value="恢复：保留发布标识和尝试记录；不凭文件存在即认定成功；不因重试重复产生交付文件。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#243B53;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1565" width="1690" height="75" />
        </mxCell>
        <mxCell id="lawyer" value="律师在生成窗口&#10;“准备正式交付”" style="rounded=1;arcSize=10;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=23;fillColor=#FEEBC8;strokeColor=#A0AEC0;fontColor=#243B53;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="220" width="420" height="120" />
        </mxCell>
